# Copy to .env.local and fill in. Ask the project owner for values.
# NEVER commit real values — this repo is public.

# Supabase (client-side; the anon key is public by design but still not committed here)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# QA access — enables /qa-login?token=... (payments simulated in QA sessions).
# Server-side only. For Playwright, export QA_ACCESS_TOKEN in your shell instead.
QA_ACCESS_TOKEN=<ask-owner>

# Playwright target (defaults to production)
# QA_BASE_URL=http://localhost:3000

# Shared PIN for the public /purchase-request form (not the staff facility
# login). If set, the form and POST /api/purchase-requests require this PIN
# (cookie lasts 12 hours). If unset, the form is open to anyone with the
# link — fine for local/dev; set this in production.
# PURCHASE_REQUEST_PIN=

# Optional. POST JSON summary when a staff purchase request is created.
# Slack incoming-webhook URLs work (payload includes a `text` field).
# PURCHASE_REQUEST_WEBHOOK_URL=https://hooks.slack.com/services/...

# Slack mention prepended on the webhook `text` (pings Krishan / Al by default).
# Accepts <@U04CNB3SMRN> or just U04CNB3SMRN. Set empty to omit the mention.
# PURCHASE_REQUEST_SLACK_MENTION=<@U04CNB3SMRN>
